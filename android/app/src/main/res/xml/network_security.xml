<?xml version="1.0" encoding="utf-8"?>
<!-- Rex over a tailnet is often plain HTTP on 100.x; WireGuard already encrypts it. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
