<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device transfer from Android 12. The host cache (session titles, cwds, agent prompts) stays on the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cache/" />
    </device-transfer>
</data-extraction-rules>
